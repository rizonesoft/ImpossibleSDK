# The pinned llvm-mingw, building 64-bit Windows programs from either host.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES IMPOSSIBLE_LLVM)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(CMAKE_HOST_WIN32)
    set(_exe .exe)
endif()
file(TO_CMAKE_PATH "${IMPOSSIBLE_LLVM}" _llvm)
set(CMAKE_C_COMPILER "${_llvm}/bin/x86_64-w64-mingw32-clang${_exe}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_RC_COMPILER "${_llvm}/bin/x86_64-w64-mingw32-windres${_exe}")
set(CMAKE_AR "${_llvm}/bin/llvm-ar${_exe}" CACHE FILEPATH "")
set(CMAKE_RANLIB "${_llvm}/bin/llvm-ranlib${_exe}" CACHE FILEPATH "")
