{
  "schema_version": 1,
  "name": "impossible-sdk",
  "agent": "claude",
  "model": "opus",
  "effort": "medium",
  "prompt_file": "docs/unattended-prompt.md",
  "branch": "main",
  "skip_permissions": true,
  "tools": [
    "git",
    "python3",
    "tmux"
  ],
  "min_disk_gb": 20,
  "min_ram_gb": 2,
  "tick_seconds": 300,
  "idle_minutes": 45,
  "stall_hours": 6,
  "preflight": [
    {
      "name": "todo-graph",
      "command": [
        "python3",
        "scripts/todo-graph.py",
        "validate"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "plan-sync",
      "command": [
        "python3",
        "scripts/todo-graph.py",
        "plan",
        "--check"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "review-pin",
      "command": [
        "python3",
        "scripts/review_pin.py",
        "--check",
        "--all"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "build",
      "command": [
        "python3",
        "tools/build.py"
      ],
      "timeout_seconds": 900
    }
  ],
  "runners": {
    "agy": {
      "model": "gemini-4-neon-medium",
      "effort": "medium"
    }
  }
}
